+// FDM patch 0003b: validated settings of the switch of patch 0003, and read access to the counters of
+// patch 0002. A refused value throws and leaves the setting as it was.
+
+void FGPropagate::SetRateSchemeOnContact(int id)
+{
+  // -1 = no switching; otherwise a scheme that can integrate the body rates (not 6 to 8, which are
+  // for the attitude only).
+  if (!(id == -1 || (id >= eNone && id <= eAdamsBashforth4) || id == eAdamsBashforth5 || id == eImplicitMidpoint)) {
+    LogException err;
+    err << "simulation/integrator/rate/rotational-on-contact: invalid value " << id
+        << " (valid: -1 no switching, 0 to 5, 9, 10)";
+    throw err;
+  }
+  integrator_rotational_rate_contact = id;
+}
+
+void FGPropagate::SetContactHoldSec(double seconds)
+{
+  if (!(seconds >= 0.0) || std::isinf(seconds)) {
+    LogException err;
+    err << "simulation/integrator/rate/contact-hold-sec: invalid value " << seconds
+        << " (must be finite and not negative)";
+    throw err;
+  }
+  contactHoldSec = seconds;
+}
+
+void FGPropagate::SetContactReleaseMode(int mode)
+{
+  if (mode != 0 && mode != 1) {
+    LogException err;
+    err << "simulation/integrator/rate/contact-release-mode: invalid value " << mode
+        << " (valid: 0 keep the history, 1 restart it)";
+    throw err;
+  }
+  contactReleaseMode = mode;
+}
+
+double FGPropagate::GetMidpointCounter(int which) const
+{
+  switch (which) {
+  case 0: return midpoint.steps;
+  case 1: return midpoint.newtonIterations;
+  case 2: return midpoint.maxNewtonIterations;
+  case 3: return midpoint.splitSteps;
+  case 4: return midpoint.roundingExits;
+  case 5: return midpoint.eulerFallbacks;
+  case 6: return midpoint.notConverged;
+  default: return midpoint.singular;
+  }
+}
+
