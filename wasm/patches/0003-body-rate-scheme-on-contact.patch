@@ -226,10 +240,30 @@ bool FGPropagate::Run(bool Holding)
 
   if (!FDMExec->IntegrationSuspended()) {
     Integrate(VState.qAttitudeECI,      VState.vQtrndot,      VState.dqQtrndot,          dt, integrator_rotational_position);
-    if (integrator_rotational_rate == eImplicitMidpoint)
+    // FDM patch 0003 (body-rate scheme switched on ground contact). With the switch off (-1, the
+    // default) rate_scheme is integrator_rotational_rate and nothing else here is executed.
+    eIntegrateType rate_scheme = integrator_rotational_rate;
+    if (integrator_rotational_rate_contact >= 0) {
+      // in.AnyContact: a contact point (BOGEY or STRUCTURE) touched the ground when the derivative
+      // integrated below was computed, so that derivative contains ground forces.
+      if (in.AnyContact) contactTimer = contactHoldSec;
+      const bool useContact = in.AnyContact || contactTimer > 0.0;
+      if (!in.AnyContact && contactTimer > 0.0) contactTimer -= dt;
+      if (useContact != contactActive) {
+        contactActive = useContact;
+        contactSwitches++;
+        // Back in the air: the multistep history still holds derivatives that contain ground
+        // forces. Extrapolating from them would add an impulse of about half a step of the last
+        // ground moment. Mode 1 restarts the history from the current derivative, as JSBSim does at
+        // start-up (the first step is then an Euler step). Mode 0 keeps the history (comparison).
+        if (!useContact && contactReleaseMode == 1) VState.dqPQRidot.assign(5, in.vPQRidot);
+      }
+      if (useContact) rate_scheme = (eIntegrateType)integrator_rotational_rate_contact;
+    }
+    if (rate_scheme == eImplicitMidpoint)
       IntegrateMidpoint(dt);
     else
-      Integrate(VState.vPQRi,           in.vPQRidot,          VState.dqPQRidot,          dt, integrator_rotational_rate);
+      Integrate(VState.vPQRi,           in.vPQRidot,          VState.dqPQRidot,          dt, rate_scheme);
     Integrate(VState.vInertialPosition, VState.vInertialVelocity, VState.dqInertialVelocity, dt, integrator_translational_position);
     Integrate(VState.vInertialVelocity, in.vUVWidot,          VState.dqUVWidot,          dt, integrator_translational_rate);
   }
