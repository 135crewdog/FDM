+  PropertyManager->Tie("simulation/integrator/rate/rotational-on-contact", &integrator_rotational_rate_contact);
+  PropertyManager->Tie("simulation/integrator/rate/contact-hold-sec", &contactHoldSec);
+  PropertyManager->Tie("simulation/integrator/rate/contact-release-mode", &contactReleaseMode);
+  PropertyManager->Tie("simulation/integrator/rate/contact-active", &contactActive);
+  PropertyManager->Tie("simulation/integrator/rate/contact-switches", &contactSwitches);
   // FDM patch 0002: counters of the implicit midpoint scheme (id 10 above). They only count.
   PropertyManager->Tie("simulation/integrator/midpoint/steps", &midpoint.steps);
   PropertyManager->Tie("simulation/integrator/midpoint/newton-iterations", &midpoint.newtonIterations);
