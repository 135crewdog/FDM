+// FDM patch 0001 (integrator-aware friction).
+// Weights of the linear multistep schemes of FGPropagate::Integrate, which advances a rate by
+// dt*(b[0]*d(n) + b[1]*d(n-1) + ...), d(n) being the newest derivative. Returns the number of past
+// derivatives the scheme uses, or 0 for the schemes that only use d(n) with weight 1 (Euler) or that
+// are not linear multistep schemes: for those JSBSim's own formula is already exact.
+static int MultistepWeights(int scheme, double b[5])
+{
+  b[0] = 1.0; b[1] = b[2] = b[3] = b[4] = 0.0;
+  switch (scheme) {
+  case FGPropagate::eTrapezoidal:
+    b[0] = 0.5; b[1] = 0.5; return 1;
+  case FGPropagate::eAdamsBashforth2:
+    b[0] = 1.5; b[1] = -0.5; return 1;
+  case FGPropagate::eAdamsBashforth3:
+    b[0] = 23./12.; b[1] = -16./12.; b[2] = 5./12.; return 2;
+  case FGPropagate::eAdamsBashforth4:
+    b[0] = 55./24.; b[1] = -59./24.; b[2] = 37./24.; b[3] = -9./24.; return 3;
+  case FGPropagate::eAdamsBashforth5:
+    b[0] = 1901./720.; b[1] = -1387./360.; b[2] = 109./30.; b[3] = -637./360.; b[4] = 251./720.; return 4;
+  default:
+    return 0;
+  }
+}
