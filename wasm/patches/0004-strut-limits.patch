   FGLGear::Inputs in;
 
+  /// FDM patch 0004 (strut limits for BOGEY contacts). Off by default: JSBSim unchanged.
+  struct StrutLimits {
+    int enabled = 0;                    ///< 0 = JSBSim unchanged (default), 1 = the three limits below apply
+    double minProjection = 0.5;         ///< floor of the leg's projection on the ground normal (0.5 = 60 deg of tilt)
+    double maxForceWeights = 5.0;       ///< largest strut force of one wheel, in units of the aircraft's weight
+    double maxTravelLegFraction = 0.5;  ///< largest compression, as a fraction of the height of the CG above the wheel
+    double projectionFloored = 0.0;     ///< counters (steps x wheels in which a limit acted); never read by the simulation
+    double forceCapped = 0.0;
+    double travelExceeded = 0.0;
+  };
+  StrutLimits strutLimits;
+  int GetStrutLimitsEnabled(void) const { return strutLimits.enabled; }
+  void SetStrutLimitsEnabled(int v);
+  double GetStrutMinProjection(void) const { return strutLimits.minProjection; }
+  void SetStrutMinProjection(double v);
+  double GetStrutMaxForceWeights(void) const { return strutLimits.maxForceWeights; }
+  void SetStrutMaxForceWeights(double v);
+  double GetStrutMaxTravelLegFraction(void) const { return strutLimits.maxTravelLegFraction; }
+  void SetStrutMaxTravelLegFraction(double v);
+  double GetStrutLimitCounter(int which) const
+  { return which == 0 ? strutLimits.projectionFloored : which == 1 ? strutLimits.forceCapped : strutLimits.travelExceeded; }
+
 private:
