+//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+// FDM patch 0004: settings of the strut limits. A refused value throws and leaves the setting as it was.
+
+[[noreturn]] static void RefuseStrutLimit(const char* name, double v, const char* valid)
+{
+  LogException err;
+  err << "gear/strut-limits/" << name << ": invalid value " << v << " (" << valid << ")";
+  throw err;
+}
+
+void FGGroundReactions::SetStrutLimitsEnabled(int v)
+{
+  if (v != 0 && v != 1) RefuseStrutLimit("enabled", v, "valid: 0 JSBSim unchanged, 1 limits on");
+  strutLimits.enabled = v;
+}
+
+void FGGroundReactions::SetStrutMinProjection(double v)
+{
+  if (!(v > 0.0 && v <= 1.0)) RefuseStrutLimit("min-projection", v, "must be above 0 and at most 1");
+  strutLimits.minProjection = v;
+}
+
+void FGGroundReactions::SetStrutMaxForceWeights(double v)
+{
+  if (!(v > 0.0) || std::isinf(v)) RefuseStrutLimit("max-force-weights", v, "must be finite and above 0");
+  strutLimits.maxForceWeights = v;
+}
+
+void FGGroundReactions::SetStrutMaxTravelLegFraction(double v)
+{
+  if (!(v > 0.0) || std::isinf(v)) RefuseStrutLimit("max-travel-leg-fraction", v, "must be finite and above 0");
+  strutLimits.maxTravelLegFraction = v;
+}
+
 //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 
